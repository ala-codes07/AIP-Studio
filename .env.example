# Copy to .env and replace SECRET_KEY with a fresh random value.
# Never commit real credentials or an .env file to a public repository.
APP_ENV=development
DEBUG=false
SECRET_KEY=REPLACE_THIS_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
DATABASE_URL=sqlite+pysqlite:///./platform.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
# Optional AI narrative. Disabled until these are configured:
LLM_PROVIDER=local
# To enable a free genuine generative AI model, install Ollama on this computer:
# LLM_PROVIDER=ollama
# LLM_MODEL=gemma3:1b
# Docker-only database credentials (change before deployment):
POSTGRES_USER=aip
POSTGRES_DB=aip
POSTGRES_PASSWORD=local_development_only_change_me

# Email verification and password reset.
# Development: codes are printed only to local server terminal, NOT emailed.
# For actual inbox delivery set EMAIL_MODE=smtp and provide working SMTP settings.
EMAIL_MODE=console
# EMAIL_MODE=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-app-password-here
# SMTP_FROM=your-address@gmail.com

# OPTIONAL: Cloud invite-only beta (values belong in Render secrets, not Git)
# EMAIL_MODE=brevo
# BREVO_API_KEY=SET_IN_RENDER_ONLY
# SMTP_FROM=sender@example.com
# BETA_ALLOWED_EMAILS=your-beta-email@example.com,invited-colleague@example.com
# EMBEDDED_SCAN_WORKER=true
# APP_ENV=production
# DATABASE_URL=postgresql://user:password@your-neon-host/db?sslmode=require
